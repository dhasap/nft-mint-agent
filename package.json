{
  "name": "nft-mint-agent",
  "version": "3.4.0",
  "description": "Competitive multi-wallet NFT auto-minting agent for OpenSea/SeaDrop and direct contracts. Low-latency fast-mint (raw EIP-1559, multi-RPC fan-out, RBF), scheduled drops, browser fallback, and listing. Runs as an MCP server, a Hermes/Claude agent skill, or a standalone CLI.",
  "keywords": [
    "nft",
    "minting",
    "nft-mint",
    "nft-bot",
    "mint-bot",
    "auto-minting",
    "ethereum",
    "web3",
    "evm",
    "opensea",
    "opensea-bot",
    "seaport",
    "seadrop",
    "fast-mint",
    "multi-wallet",
    "scheduled-mint",
    "browser-minting",
    "erc721",
    "erc1155",
    "ethers",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "hermes-agent",
    "claude",
    "gas-optimization",
    "multi-chain",
    "defi",
    "blockchain",
    "typescript"
  ],
  "author": "dhasap",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhasap/nft-mint-agent.git"
  },
  "bugs": {
    "url": "https://github.com/dhasap/nft-mint-agent/issues"
  },
  "homepage": "https://github.com/dhasap/nft-mint-agent#readme",
  "main": "dist/index.js",
  "bin": {
    "nft-mint-mcp": "mcp-server.mjs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "node mcp-server.mjs",
    "signing-proxy": "node dist/browser/proxy-server.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "generate-wallets": "ts-node src/wallet/generate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
