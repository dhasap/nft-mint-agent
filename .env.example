
# ============================================
# NFT Minting Skill v3.2 - Configuration
# ============================================

# RPC Node URL (Alchemy, QuickNode, Infura)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Chain: ethereum, polygon, arbitrum, base, optimism, zora, blast, robinhood
CHAIN=ethereum

# Wallet Private Keys (comma-separated for multi-wallet)
WALLET_PRIVATE_KEYS=

# Gas Settings
MAX_GAS_PRICE_GWEI=100
PRIORITY_FEE_GWEI=
GAS_LIMIT_MULTIPLIER=1.2

# Gas Mode: eco (0.8x), normal (1x), aggressive (1.5x), custom (uses CUSTOM_GAS_MULTIPLIER)
GAS_MODE=aggressive
CUSTOM_GAS_MULTIPLIER=1.0
CUSTOM_PRIORITY_GWEI=5

# Mint Settings
DEFAULT_MINT_QUANTITY=1
MAX_MINT_PRICE_ETH=0.5

# OpenSea API Key (for listing via API)
OPENSEA_API_KEY=

# Safety Settings
DRY_RUN=false

# ============================================
# Fast-Mint (competitive low-latency) tuning
# ============================================
# NOTE: leave PRIORITY_FEE_GWEI empty above to use the higher mode-scaled defaults
#       (eco=1, normal=2, aggressive=5 gwei). Set it only to force a fixed tip.

# Extra RPC endpoints for fan-out broadcast (comma-separated). The primary RPC_URL
# is always included. More endpoints = faster mempool propagation = earlier inclusion.
BROADCAST_RPC_URLS=

# How early (ms) before target to broadcast. Too early can revert with NotActive.
FAST_MINT_EARLY_MS=750

# How early (ms) before broadcast to PRE-SIGN txs (local CPU work, off the hot path).
FAST_MINT_PRESIGN_LEAD_MS=1500

# Live drop/gas re-poll interval (ms).
FAST_MINT_POLL_MS=250

# Replace-by-fee: if a tx is not mined within this window (ms), bump gas and resend.
# ~13000ms ≈ one Ethereum block. Lower it on fast L2s (Base/Arbitrum/Optimism).
FAST_MINT_RBF_AFTER_MS=13000

# Max RBF bumps per wallet, and the bump factor per attempt (1.18 = +18%, valid >=10% RBF).
FAST_MINT_RBF_MAX=4
FAST_MINT_RBF_BUMP=1.18

# Fixed upfront gas limit used per mint tx (unused gas is refunded).
FAST_MINT_GAS_LIMIT=650000
